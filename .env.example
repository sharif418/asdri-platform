# ————— ASDRI platform — sandbox development environment —————
DATABASE_URL="postgresql://user:password@host:5432/asdri?schema=public"

# Session signing + CSRF secret (dev-only value; production refuses to boot without a real one)
SESSION_SECRET="generate with: openssl rand -hex 32"

# Object storage (MinIO in the sandbox; S3/any endpoint in production)
S3_ENDPOINT="http://127.0.0.1:9100"
S3_REGION="us-east-1"
S3_BUCKET="asdri-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE="true"

# Mail (log driver writes to the DB outbox; smtp used only in production)
MAIL_DRIVER="log"

# Payments (sandbox provider in dev; real provider adapter chosen in production)
PAYMENT_PROVIDER="sandbox"
PAYMENT_CALLBACK_SECRET="generate with: openssl rand -hex 32"

# Public origin (metadataBase, sitemap, hreflang alternates)
NEXT_PUBLIC_SITE_URL="https://assunnahinstitute.org"

# Seed admin (bootstrap only; the office changes passwords on first login)
SEED_ADMIN_EMAIL="admin@assunnahinstitute.org"
SEED_ADMIN_PASSWORD=""
